 X_val = X.iloc[tr], X.iloc[val]\n    y_tr, y_val = y.iloc[tr], y.iloc[val]\n\n    model = lgb.LGBMClassifier(\n        n_estimators=7000,\n        learning_rate=0.03,\n        num_leaves=64,\n        min_data_in_leaf=50,\n        subsample=0.85,\n        colsample_bytree=0.85,\n        objective='binary',\n        random_state=42\n    )\n\n    model.fit(\n        X_tr, y_tr,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        categorical_feature=cat_cols,\n        callbacks=[\n            lgb.early_stopping(100),\n            lgb.log_evaluation(0)\n        ]\n    )\n\n    preds = model.predict_proba(X_val)[:, 1]\n    auc = roc_auc_score(y_val, preds)\n    auc_scores.append(auc)\n\n    print(f\"Fold {fold} AUC: {auc:.4f}\")\n\nprint(\"\\nMean CV AUC:\", np.mean(auc_scores))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-24T07:46:17.216206Z","iopub.execute_input":"2025-12-24T07:46:17.216657Z","iopub.status.idle":"2025-12-24T07:53:54.292357Z","shell.execute_reply.started":"2025-12-24T07:46:17.216624Z","shell.execute_reply":"2025-12-24T07:53:54.291467Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nimport joblib\n\n# Load data\ntrain_df = pd.read_csv(\"/kaggle/input/playground-series-s5e12/train.csv\")\n\n# Feature engineering\ntrain_df['pulse_pressure'] = train_df['systolic_bp'] - train_df['diastolic_bp']\ntrain_df['sleep_deviation'] = np.abs(train_df['sleep_hours_per_day'] - 7.5)\n\n# Categorical columns\ncat_cols = [\n    'gender', 'ethnicity', 'education_level',\n    'income_level', 'smoking_status', 'employment_status'\n]\n\nfor col in cat_cols:\n    train_df[col] = train_df[col].astype('category')\n\nX = train_df.drop(columns=['diagnosed_diabetes', 'id'])\ny = train_df['diagnosed_diabetes']\n\n# LightGBM model \nmodel = lgb.LGBMClassifier(\n    n_estimators=7000,\n    learning_rate=0.03,\n    num_leaves=64,\n    min_data_in_leaf=50